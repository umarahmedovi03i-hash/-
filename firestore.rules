rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Shaxsiy profil: faqat egasi (yoki admin) o‘qiydi/yozadi. Email bu yerda saqlanmaydi.
    match /Profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 11
        && request.resource.data.xp == 0;
      allow update: if (isOwner(uid) || isAdmin())
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 11
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 2000;
    }

    match /Avatars/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /Music/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /Achievements/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /Settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /Certificates/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Reyting: faqat ism, rasm, sinf va ball. Shaxsiy ma’lumot yo‘q.
    match /Leaderboards/{board}/entries/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && request.resource.data.totalScore <= 1000;
      allow update: if isOwner(uid)
        && request.resource.data.totalScore >= resource.data.totalScore
        && request.resource.data.totalScore - resource.data.totalScore <= 1000;
    }

    // AI testlar: yaratish faqat Cloud Function (admin SDK) orqali. O‘quvchi faqat tasdiqlanganini o‘qiydi.
    match /AIGeneratedTests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'approved');
      allow update, delete: if isAdmin();
      allow create: if false;
    }
  }
}
